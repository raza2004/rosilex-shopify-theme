# Image engine: openai or gemini (Gemini image models need billing on the Gemini project)
GENERATOR=openai
OPENAI_API_KEY=
# Optional: defaults to gpt-image-1.5 (supports input_fidelity high). gpt-image-1 was shut down on 2026-10-23.
OPENAI_IMAGE_MODEL=gpt-image-1.5
GEMINI_API_KEY=
# Optional: defaults to gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Comma separated store origins allowed to call the API
ALLOWED_ORIGINS=https://rosexious.myshopify.com,http://127.0.0.1:9292
# Requests per client IP per window
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=600
# Set to true behind a proxy that sets X-Forwarded-For (Render, Hugging Face Spaces)
TRUST_FORWARDED_FOR=true
# Optional override; normally read from config/threshold.json
# IDENTITY_THRESHOLD=
# Image generations per request when the identity score is below the threshold (1 to 3). 1 while testing saves credit.
MAX_ATTEMPTS=3
# Image model calls allowed per visitor IP in any 24 hours (0 turns the limit off)
DAILY_GENERATION_LIMIT=3
# IPs with no daily limit, comma separated (for example the owner's public IP)
QUOTA_EXEMPT_IPS=
# Visitor log (JSON) path inside the container; empty turns the log off
VISITORS_FILE=/data/visitors.json
