{% comment %}
  This section is used in the article template to render the article page, which
  displays the full content of the blog post and can optionally include a
  comments section for customers.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/article
{% endcomment %}

{%- assign date = article.published_at | time_tag: format: 'date' -%}
{%- capture metadata -%}
  <p>{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
{%- endcapture -%}

<article class="article page-section">
  {% render 'page-header', title: article.title, eyebrow: blog.title, text: metadata %}

  {% if article.image %}
    <div class="article__media" data-motion="clip" data-parallax>
      {{
        article.image
        | image_url: width: 2400
        | image_tag:
          widths: '800, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: article.image.alt
      }}
    </div>
  {% endif %}

  <div class="article__body rte" data-motion="rise">
    {{ article.content }}
  </div>

  {% if blog.comments_enabled? %}
    <section class="article__comments" id="comments" aria-labelledby="Comments-{{ section.id }}">
      <h2 id="Comments-{{ section.id }}" data-motion="lines">{{ 'blog.article_comments' | t }}</h2>

      {% paginate article.comments by 10 %}
        <ol class="article__comment-list" role="list" data-motion="rise">
          {% for comment in article.comments %}
            <li class="article__comment">
              <p class="eyebrow text-muted">
                {{ comment.author | escape }} &middot; {{ comment.created_at | time_tag: format: 'date' }}
              </p>
              <div class="rte">{{ comment.content }}</div>
            </li>
          {% endfor %}
        </ol>

        {% if paginate.pages > 1 %}
          {{ paginate | default_pagination: anchor: 'comments' }}
        {% endif %}
      {% endpaginate %}

      {% form 'new_comment', article, class: 'article__form' %}
        <h3>{{ 'blog.comment_form_title' | t }}</h3>

        {{ form.errors | default_errors }}

        <div class="article__form-row">
          <div class="field">
            <label class="field__label" for="CommentAuthor-{{ section.id }}">{{ 'blog.comment_form_name' | t }}</label>
            <input class="field__input" type="text" name="comment[author]" id="CommentAuthor-{{ section.id }}" value="{{ form.author }}" autocomplete="name" required>
          </div>

          <div class="field">
            <label class="field__label" for="CommentEmail-{{ section.id }}">{{ 'blog.comment_form_email' | t }}</label>
            <input class="field__input" type="email" name="comment[email]" id="CommentEmail-{{ section.id }}" value="{{ form.email }}" autocomplete="email" required>
          </div>
        </div>

        <div class="field">
          <label class="field__label" for="CommentBody-{{ section.id }}">{{ 'blog.comment_form_body' | t }}</label>
          <textarea class="field__input" name="comment[body]" id="CommentBody-{{ section.id }}" required>{{ form.body }}</textarea>
        </div>

        <div>
          <button type="submit" class="button button--primary" data-magnetic>{{ 'blog.comment_form_submit' | t }}</button>
        </div>
      {% endform %}
    </section>
  {% endif %}
</article>

{% stylesheet %}
  .article__media {
    height: 70svh;
    margin-block-end: var(--space-2xl);
    overflow: hidden;
    background-color: var(--color-surface);
  }

  .article__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article__body,
  .article__comments {
    margin-inline: auto;
  }

  .article__comments {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    max-width: 68ch;
    margin-block-start: var(--space-3xl);
    padding-block-start: var(--space-2xl);
    border-block-start: 1px solid var(--color-border);
  }

  .article__comment-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .article__form-row {
    display: grid;
    gap: var(--space-l);
  }

  @media screen and (min-width: 750px) {
    .article__form-row {
      grid-template-columns: 1fr 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.article",
  "settings": []
}
{% endschema %}
