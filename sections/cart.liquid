{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart. It is a plain form post, so it
  works without JavaScript; the slide-in drawer covers the faster path.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<div class="cart-page page-section">
  {%- assign page_title_text = 'cart.title' | t -%}
  {% render 'page-header', title: page_title_text, eyebrow: shop.name %}

  {% if cart.item_count > 0 %}
    <form class="cart-page__form" action="{{ routes.cart_url }}" method="post">
      <ul class="cart-page__items" role="list" data-motion="rise">
        {% for item in cart.items %}
          <li class="cart-row">
            <a class="cart-row__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
              {% if item.image %}
                {{ item.image | image_url: width: 400 | image_tag: widths: '200, 400', sizes: '8rem', loading: 'lazy', alt: '' }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'cart-row__placeholder' }}
              {% endif %}
            </a>

            <div class="cart-row__details">
              <a class="cart-row__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
              {% unless item.product.has_only_default_variant %}
                <p class="text-muted">{{ item.variant.title | escape }}</p>
              {% endunless %}
              <a class="cart-row__remove" href="{{ item.url_to_remove }}" aria-label="{{ 'cart.remove_item' | t: title: item.product.title | escape }}">
                {{- 'cart.remove' | t -}}
              </a>
            </div>

            <div class="cart-row__quantity field">
              <label class="field__label" for="Quantity-{{ item.key }}">{{ 'products.quantity' | t }}</label>
              <input
                class="field__input"
                id="Quantity-{{ item.key }}"
                type="number"
                name="updates[]"
                value="{{ item.quantity }}"
                min="0"
                inputmode="numeric"
              >
            </div>

            <p class="cart-row__price">{{ item.final_line_price | money }}</p>
          </li>
        {% endfor %}
      </ul>

      <div class="cart-page__summary" data-motion="up">
        <div class="cart-page__subtotal">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money_with_currency }}</span>
        </div>
        <p class="text-muted">{{ 'cart.taxes_note' | t }}</p>
        <div class="cart-page__actions">
          <button type="submit" class="button" name="update">{{ 'cart.update' | t }}</button>
          <button type="submit" class="button button--primary" name="checkout" data-magnetic>{{ 'cart.checkout' | t }}</button>
        </div>
      </div>
    </form>
  {% else %}
    <div class="cart-page__empty" data-motion="up">
      <p>{{ 'cart.empty' | t }}</p>
      <a class="button button--primary" href="{{ routes.all_products_collection_url }}" data-magnetic>{{ 'cart.continue_shopping' | t }}</a>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .cart-page__form {
    display: grid;
    gap: var(--space-2xl);
  }

  .cart-page__items {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--color-border);
  }

  .cart-row {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr) auto;
    gap: var(--space-s) var(--space-m);
    align-items: start;
    padding-block: var(--space-l);
    border-block-end: 1px solid var(--color-border);
  }

  .cart-row__media {
    grid-row: span 2;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: var(--color-surface);
  }

  .cart-row__media img,
  .cart-row__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    fill: var(--color-border);
  }

  .cart-row__details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2xs);
  }

  .cart-row__title {
    font-family: var(--font-display--family);
    font-size: var(--text-xl);
    text-decoration: none;
  }

  .cart-row__remove {
    font-size: var(--text-s);
    color: var(--color-muted);
  }

  .cart-row__quantity {
    grid-column: 2;
    max-width: 6rem;
  }

  .cart-row__price {
    grid-column: 3;
    grid-row: 1;
  }

  .cart-page__summary {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .cart-page__subtotal {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-xl);
  }

  .cart-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-start: var(--space-s);
  }

  .cart-page__actions .button {
    flex: 1;
  }

  .cart-page__empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-m);
  }

  @media screen and (min-width: 990px) {
    .cart-page__form {
      grid-template-columns: 7fr 4fr;
      align-items: start;
      gap: var(--space-3xl);
    }

    .cart-row {
      grid-template-columns: 8rem minmax(0, 1fr) 7rem auto;
    }

    .cart-row__quantity {
      grid-column: 3;
      grid-row: 1;
    }

    .cart-row__price {
      grid-column: 4;
    }

    .cart-page__summary {
      position: sticky;
      top: var(--space-l);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
