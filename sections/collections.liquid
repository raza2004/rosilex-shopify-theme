{% comment %}
  This section is used in the list-collections template to render a list of
  collections. Collections alternate between wide and narrow tiles, each image
  unmasking with a clip wipe as it scrolls into view.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<div class="collections page-section">
  {%- assign page_title_text = 'collections.title' | t -%}
  {% render 'page-header', title: page_title_text, eyebrow: shop.name, badge: true, id: section.id %}

  <ul class="collections__list" role="list">
    {% for collection in collections %}
      <li class="collection-tile">
        <a class="collection-tile__link" href="{{ collection.url }}" data-cursor="{{ 'general.cursor_view' | t | escape }}">
          <div class="collection-tile__media" data-motion="clip" data-parallax>
            {% assign tile_image = collection.featured_image | default: collection.products.first.featured_image %}
            {% if tile_image %}
              {{
                tile_image
                | image_url: width: 1600
                | image_tag:
                  widths: '500, 800, 1200, 1600',
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  loading: 'lazy',
                  alt: ''
              }}
            {% else %}
              {% render 'product-cover', title: collection.title %}
            {% endif %}
          </div>

          <div class="collection-tile__copy" data-motion="up">
            <h2 class="collection-tile__title">{{ collection.title | escape }}</h2>
            <p class="eyebrow text-muted">
              {{ 'collections.product_count' | t: count: collection.products_count }}
            </p>
          </div>
        </a>
      </li>
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .collections__list {
    display: grid;
    gap: var(--space-2xl);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collection-tile__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    text-decoration: none;
  }

  .collection-tile__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: var(--color-surface);
  }

  .collection-tile__media img,
  .collection-tile__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    fill: var(--color-border);
  }

  .collection-tile__copy {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-s);
  }

  .collection-tile__title {
    font-size: var(--text-xl);
  }

  /* Desktop: a 12-column rhythm of wide and narrow tiles, the narrow ones sitting lower. */
  @media screen and (min-width: 990px) {
    .collections__list {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--space-3xl) var(--space-l);
    }

    .collection-tile:nth-child(4n + 1) {
      grid-column: 1 / span 7;
    }

    .collection-tile:nth-child(4n + 2) {
      grid-column: 9 / span 4;
      margin-block-start: var(--space-3xl);
    }

    .collection-tile:nth-child(4n + 3) {
      grid-column: 2 / span 4;
    }

    .collection-tile:nth-child(4n + 4) {
      grid-column: 7 / span 6;
      margin-block-start: calc(var(--space-3xl) * -1);
    }

    .collection-tile:nth-child(4n + 1) .collection-tile__media,
    .collection-tile:nth-child(4n + 4) .collection-tile__media {
      aspect-ratio: 5 / 4;
    }

    .collection-tile__title {
      font-size: var(--text-2xl);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}
