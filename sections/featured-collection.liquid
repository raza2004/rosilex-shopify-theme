{% liquid
  # Falls back to the automatic "all" collection (every product on the Online Store channel)
  assign featured = section.settings.collection | default: collections.all

  # Blank text settings fall back to the translated default copy in the locale files
  assign default_eyebrow = 'sections.featured_collection.eyebrow' | t
  assign default_headline = 'sections.featured_collection.headline_html' | t
  assign default_text = 'sections.featured_collection.text_html' | t
  assign default_link_label = 'sections.featured_collection.link_label' | t
  assign eyebrow = section.settings.eyebrow | default: default_eyebrow
  assign headline = section.settings.headline | default: default_headline
  assign text = section.settings.text | default: default_text
  assign link_label = section.settings.link_label | default: default_link_label

  # Gift cards never headline the edit, and products with photos come first.
  assign candidates = featured.products | reject: 'gift_card?'
  assign with_media = candidates | where: 'featured_media'
  assign without_media = candidates | reject: 'featured_media'
  assign featured_products = with_media | concat: without_media
%}

<div class="featured-collection {{ section.settings.large_position }}">
  <header class="featured-collection__header">
    <div class="featured-collection__heading">
      <p class="eyebrow">{{ eyebrow | escape }}</p>
      <h2 data-motion="lines">{{ headline }}</h2>
    </div>

    <div class="featured-collection__aside">
      <div class="text-muted measure">{{ text }}</div>

      {% if featured != blank %}
        <a class="link-sweep" href="{{ featured.url }}" data-magnetic>
          {{- link_label | escape -}}
        </a>
      {% endif %}
    </div>
  </header>

  <div class="featured-collection__grid" data-motion="rise">
    {% if featured_products.size > 0 %}
      {% for product in featured_products limit: 3 %}
        {% liquid
          if forloop.first
            assign sizes = '(min-width: 750px) 55vw, 100vw'
          else
            assign sizes = '(min-width: 750px) 30vw, 50vw'
          endif
        %}
        {% render 'product-card', product: product, sizes: sizes, css_class: 'featured-collection__item' %}
      {% endfor %}
    {% else %}
      {% for i in (1..3) %}
        {% render 'product-card', css_class: 'featured-collection__item' %}
      {% endfor %}
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .featured-collection {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    padding-block: var(--space-section);
  }

  .featured-collection__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .featured-collection__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .featured-collection__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-m);
  }

  /* Mobile: the large product spans both columns, the small two sit offset below. */
  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl) var(--space-s);
  }

  .featured-collection__item:first-child {
    grid-column: 1 / -1;
  }

  .featured-collection__item:nth-child(3) {
    margin-block-start: var(--space-2xl);
  }

  .featured-collection__item:not(:first-child) .product-card__title {
    font-size: var(--text-m);
  }

  @media screen and (min-width: 750px) {
    .featured-collection__header {
      display: grid;
      grid-template-columns: 7fr 4fr;
      align-items: end;
      gap: var(--space-2xl);
    }

    .featured-collection__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--space-2xl) var(--space-l);
    }

    .featured-collection__item:first-child {
      grid-column: 1 / span 7;
      grid-row: 1 / span 2;
    }

    .featured-collection__item:nth-child(2) {
      grid-column: 9 / span 4;
      grid-row: 1;
      margin-block-start: var(--space-3xl);
    }

    .featured-collection__item:nth-child(3) {
      grid-column: 8 / span 4;
      grid-row: 2;
      align-self: end;
      margin-block-start: 0;
    }

    .featured-collection--large-right .featured-collection__item:first-child {
      grid-column: 6 / span 7;
    }

    .featured-collection--large-right .featured-collection__item:nth-child(2) {
      grid-column: 1 / span 4;
    }

    .featured-collection--large-right .featured-collection__item:nth-child(3) {
      grid-column: 2 / span 4;
    }

    .featured-collection--large-right .featured-collection__header {
      grid-template-columns: 4fr 7fr;
    }

    .featured-collection--large-right .featured-collection__heading {
      order: 1;
    }

    .featured-collection__item:not(:first-child) .product-card__title {
      font-size: var(--text-l);
    }

    .featured-collection__item:first-child .product-card__title {
      font-size: var(--text-xl);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_collection",
  "tag": "section",
  "class": "featured-collection-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "info": "t:info.locale_default"
    },
    {
      "type": "inline_richtext",
      "id": "headline",
      "label": "t:labels.headline",
      "info": "t:info.locale_default"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "info": "t:info.locale_default"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label",
      "info": "t:info.locale_default"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "large_position",
      "label": "t:labels.large_product_position",
      "options": [
        { "value": "featured-collection--large-left", "label": "t:options.alignment.left" },
        { "value": "featured-collection--large-right", "label": "t:options.alignment.right" }
      ],
      "default": "featured-collection--large-left"
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_collection"
    }
  ]
}
{% endschema %}
