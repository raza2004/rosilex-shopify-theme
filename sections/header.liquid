{% comment %}
  Site header. Desktop (990px and up): logo, inline menu, language button,
  day/night switch, account and cart. Smaller screens: logo, cart and a menu
  button that opens a full-screen menu holding the links and the same controls.

  All styles are scoped to .site-header / .mobile-menu: bare element
  selectors here would also restyle every other <header> on the page.
{% endcomment %}

{% liquid
  # Fall back to the store's default main menu when none is picked
  assign menu = section.settings.menu
  if menu == blank
    assign menu = linklists['main-menu']
  endif
%}

<header class="site-header">
  <a class="site-header__logo" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>

  {% if menu.links.size > 0 %}
    <nav class="site-header__nav" aria-label="{{ 'general.main_menu' | t }}">
      <ul class="site-header__menu" role="list">
        {% for link in menu.links %}
          <li>
            <a
              class="site-header__link"
              href="{{ link.url }}"
              {% if link.active %}
                aria-current="page"
              {% endif %}
            >
              {{- link.title | escape -}}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  {% endif %}

  <div class="site-header__actions">
    <div class="site-header__prefs">
      {% render 'language-selector', id: 'header' %}
      {% render 'theme-toggle', id: 'header' %}
    </div>

    {% if shop.customer_accounts_enabled %}
      <a class="site-header__icon site-header__account" href="{{ routes.account_url }}">
        <span class="visually-hidden">{{ 'general.account' | t }}</span>
        {{ 'icon-account.svg' | inline_asset_content }}
      </a>
    {% endif %}

    <a class="site-header__icon" href="{{ routes.cart_url }}" data-cart-drawer-trigger>
      <span class="visually-hidden">{{ 'cart.title' | t }}</span>
      {{ 'icon-cart.svg' | inline_asset_content }}
      <span class="site-header__cart-count" data-cart-count="{{ cart.item_count }}" aria-hidden="true">
        {{- cart.item_count -}}
      </span>
    </a>

    <button
      type="button"
      class="site-header__icon site-header__menu-button"
      aria-controls="MobileMenu"
      aria-expanded="false"
      data-mobile-menu-open
    >
      <span class="visually-hidden">{{ 'general.open_menu' | t }}</span>
      <span class="site-header__burger" aria-hidden="true"></span>
    </button>
  </div>
</header>

<dialog class="mobile-menu scheme-deep" id="MobileMenu" aria-label="{{ 'general.main_menu' | t }}">
  <div class="mobile-menu__top">
    <a class="mobile-menu__logo" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>
    <button type="button" class="site-header__icon" data-mobile-menu-close>
      <span class="visually-hidden">{{ 'general.close' | t }}</span>
      <svg viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
        <path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.2"/>
      </svg>
    </button>
  </div>

  {% if menu.links.size > 0 %}
    <nav aria-label="{{ 'general.main_menu' | t }}">
      <ul class="mobile-menu__links" role="list">
        {% for link in menu.links %}
          <li class="mobile-menu__item">
            <a
              class="mobile-menu__link"
              href="{{ link.url }}"
              {% if link.active %}
                aria-current="page"
              {% endif %}
            >
              {{- link.title | escape -}}
            </a>
          </li>
        {% endfor %}
        {% if shop.customer_accounts_enabled %}
          <li class="mobile-menu__item">
            <a class="mobile-menu__link" href="{{ routes.account_url }}">{{ 'general.account' | t }}</a>
          </li>
        {% endif %}
      </ul>
    </nav>
  {% endif %}

  <div class="mobile-menu__prefs mobile-menu__item">
    {% render 'language-selector', id: 'mobile', placement: 'up' %}
    {% render 'theme-toggle', id: 'mobile' %}
  </div>
</dialog>

{% stylesheet %}
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: 4.5rem;
    border-block-end: 1px solid var(--color-border);
  }

  .site-header a,
  .mobile-menu a {
    color: var(--color-foreground);
    text-decoration: none;
  }

  .site-header__logo {
    font-family: var(--font-display--family);
    font-size: var(--text-xl);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* Mobile first: the inline menu, preferences and account live in the menu dialog. */
  .site-header__nav,
  .site-header__prefs,
  .site-header__account {
    display: none;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
  }

  .site-header__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: var(--color-foreground);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .site-header__icon svg {
    width: 1.375rem;
    height: 1.375rem;
  }

  .site-header__icon:focus-visible,
  .site-header__link:focus-visible,
  .site-header__logo:focus-visible,
  .mobile-menu a:focus-visible {
    outline: 1px solid var(--color-foreground);
    outline-offset: 2px;
  }

  /* Two hairlines; the shorter one is platinum. */
  .site-header__burger,
  .site-header__burger::after {
    display: block;
    width: 1.5rem;
    height: 1px;
    background-color: var(--color-foreground);
  }

  .site-header__burger {
    position: relative;
    transform: translateY(-4px);
  }

  .site-header__burger::after {
    content: '';
    position: absolute;
    inset-inline-end: 0;
    width: 1rem;
    background-color: var(--color-metal);
    transform: translateY(8px);
  }

  .site-header__cart-count {
    position: absolute;
    inset-block-start: 0.35rem;
    inset-inline-end: 0.2rem;
    display: grid;
    place-items: center;
    min-width: 1.1rem;
    height: 1.1rem;
    padding-inline: 0.25rem;
    font-size: 0.6875rem;
    line-height: 1;
    color: var(--color-deep);
    background-color: var(--color-metal);
    border-radius: 999px;
  }

  .site-header__cart-count[data-cart-count='0'] {
    display: none;
  }

  .site-header__menu {
    display: flex;
    gap: var(--space-xl);
    margin: 0;
    padding: 0;
    list-style: none;
    white-space: nowrap;
  }

  .site-header__link {
    position: relative;
    display: inline-block;
    padding-block: var(--space-3xs);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .site-header__link::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background-color: var(--color-metal);
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform 0.6s var(--ease-out);
  }

  .site-header__link:hover::after,
  .site-header__link[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: 0% 50%;
  }

  @media screen and (min-width: 990px) {
    .site-header {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      min-height: 5.5rem;
    }

    .site-header__nav {
      display: block;
    }

    .site-header__prefs {
      display: flex;
      align-items: center;
      gap: var(--space-s);
      margin-inline-end: var(--space-xs);
    }

    .site-header__account {
      display: grid;
    }

    .site-header__actions {
      justify-self: end;
    }

    .site-header__menu-button {
      display: none;
    }
  }

  /*
   * Full-screen menu (mobile). Slides down from the top; links rise in one
   * by one. Transforms and opacity only.
   */
  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: var(--space-s) var(--page-margin) var(--space-xl);
    border: 0;
    overflow-y: auto;
    transform: translateY(-100%);
    transition: transform 0.7s var(--ease-out);
  }

  .mobile-menu[open] {
    display: flex;
    flex-direction: column;
  }

  .mobile-menu::backdrop {
    background: transparent;
  }

  .mobile-menu.is-open {
    transform: translateY(0);
  }

  .mobile-menu__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 3.5rem;
  }

  .mobile-menu__logo {
    font-family: var(--font-display--family);
    font-size: var(--text-xl);
  }

  .mobile-menu__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin: var(--space-2xl) 0 0;
    padding: 0;
    list-style: none;
  }

  .mobile-menu__link {
    font-family: var(--font-display--family);
    font-size: var(--text-3xl);
    line-height: var(--leading-heading);
  }

  .mobile-menu__link[aria-current='page'] {
    font-style: italic;
    color: var(--color-metal);
  }

  .mobile-menu__prefs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin-block-start: auto;
    padding-block-start: var(--space-xl);
    border-block-start: 1px solid var(--color-border);
  }

  .mobile-menu__item {
    opacity: 0;
    transform: translateY(1.5rem);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.8s var(--ease-out);
  }

  .mobile-menu.is-open .mobile-menu__item {
    opacity: 1;
    transform: none;
  }

  .mobile-menu.is-open .mobile-menu__item:nth-child(1) { transition-delay: 0.15s; }
  .mobile-menu.is-open .mobile-menu__item:nth-child(2) { transition-delay: 0.21s; }
  .mobile-menu.is-open .mobile-menu__item:nth-child(3) { transition-delay: 0.27s; }
  .mobile-menu.is-open .mobile-menu__item:nth-child(4) { transition-delay: 0.33s; }
  .mobile-menu.is-open .mobile-menu__item:nth-child(5) { transition-delay: 0.39s; }
  .mobile-menu.is-open .mobile-menu__item:nth-child(n + 6) { transition-delay: 0.45s; }
  .mobile-menu.is-open .mobile-menu__prefs { transition-delay: 0.4s; }

  .header__topbar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    min-height: 2.75rem;
    border-block-end: 1px solid var(--color-border);
  }

  .header__topbar-hint {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
{% endstylesheet %}

{% javascript %}
  // Mobile menu: a modal dialog (page behind is inert, Esc closes) with a
  // slide transition. Focus returns to the menu button on close.
  (() => {
    const menu = document.getElementById('MobileMenu');
    const opener = document.querySelector('[data-mobile-menu-open]');
    if (!menu || !opener) return;

    const open = () => {
      menu.showModal();
      opener.setAttribute('aria-expanded', 'true');
      window.Motion?.lenis?.stop();
      requestAnimationFrame(() => menu.classList.add('is-open'));
    };

    const close = () => {
      if (!menu.open) return;
      menu.classList.remove('is-open');
      opener.setAttribute('aria-expanded', 'false');

      const finish = () => {
        menu.close();
        window.Motion?.lenis?.start();
        opener.focus();
      };

      const reduce = !document.documentElement.classList.contains('motion-ok');
      if (reduce) return finish();

      // Links inside also fire transitionend; wait for the menu's own slide.
      const onEnd = (event) => {
        if (event.target !== menu) return;
        menu.removeEventListener('transitionend', onEnd);
        finish();
      };
      menu.addEventListener('transitionend', onEnd);
    };

    opener.addEventListener('click', open);
    menu.addEventListener('click', (event) => {
      if (event.target.closest('[data-mobile-menu-close]')) close();
    });
    menu.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });

    // Widening the window past the breakpoint closes the menu.
    matchMedia('(min-width: 990px)').addEventListener('change', (event) => {
      if (event.matches && menu.open) {
        menu.classList.remove('is-open');
        menu.close();
        opener.setAttribute('aria-expanded', 'false');
        window.Motion?.lenis?.start();
      }
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    }
  ]
}
{% endschema %}
