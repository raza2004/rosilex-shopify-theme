{% liquid
  assign selected_collection = section.settings.collection
%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=DM+Sans:wght@400;500;600&display=swap');

  #shopify-section-{{ section.id }} {
    background: var(--color-background);
    color: var(--color-foreground);
    font-family: 'DM Sans', sans-serif;
  }

  #shopify-section-{{ section.id }} .rose-home {
    max-width: 1280px;
    margin: auto;
    padding: 64px 24px;
  }

  #shopify-section-{{ section.id }} h1 {
    margin: 0 0 16px;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(40px, 6vw, 76px);
    font-weight: 500;
    line-height: 1.05;
  }

  #shopify-section-{{ section.id }} .rose-intro {
    max-width: 560px;
    margin-bottom: 40px;
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .rose-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px 20px;
  }

  #shopify-section-{{ section.id }} .rose-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .rose-card:focus-visible {
    outline: 1px solid var(--color-foreground);
    outline-offset: 5px;
  }

  #shopify-section-{{ section.id }} .rose-media {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-surface);
  }

  #shopify-section-{{ section.id }} .rose-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .rose-no-image {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 20px;
    text-align: center;
    color: var(--color-muted);
  }

  #shopify-section-{{ section.id }} .rose-title {
    margin: 16px 0 8px;
    font-size: 16px;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .rose-price {
    margin: 0;
  }

  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .rose-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    #shopify-section-{{ section.id }} .rose-home {
      padding: 40px 16px;
    }

    #shopify-section-{{ section.id }} .rose-grid {
      gap: 24px 12px;
    }
  }
</style>

<div class="rose-home">
  <h1>{{ section.settings.heading | escape }}</h1>
  <div class="rose-intro">
    {{ section.settings.introduction }}
  </div>

  {% if selected_collection != blank %}
    <div class="rose-grid">
      {% for product in selected_collection.products limit: section.settings.product_limit %}
        <a class="rose-card" href="{{ product.url }}">
          <div class="rose-media">
            {% if product.featured_image %}
              {{
                product.featured_image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  widths: '240, 400, 600, 800',
                  sizes: '(max-width: 900px) 50vw, 25vw'
              }}
            {% else %}
              <div class="rose-no-image">
                {{ section.settings.missing_image_text | escape }}
              </div>
            {% endif %}
          </div>

          <h2 class="rose-title">{{ product.title | escape }}</h2>
          <p class="rose-price">{{ product.price | money }}</p>
        </a>
      {% else %}
        <p>{{ section.settings.empty_text | escape }}</p>
      {% endfor %}
    </div>
  {% else %}
    <p>{{ section.settings.empty_text | escape }}</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Rosilex collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your daily skincare ritual"
    },
    {
      "type": "richtext",
      "id": "introduction",
      "label": "Introduction",
      "default": "<p>Explore the Rosilex skincare collection.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Maximum products",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "missing_image_text",
      "label": "Missing image text",
      "default": "Product image coming soon"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty collection message",
      "default": "Select a collection containing your skincare products."
    }
  ],
  "presets": [
    {
      "name": "Rosilex collection"
    }
  ]
}
{% endschema %}
