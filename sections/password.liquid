{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="password">
  {% render 'badge', id: section.id, css_class: 'password__badge' %}

  <p class="eyebrow text-muted" data-motion="up">{{ shop.name | escape }}</p>
  <h1 class="password__title" data-motion="lines">{{ 'password.title' | t }}</h1>

  {% if shop.password_message != blank %}
    <p class="text-muted measure" data-motion="up">{{ shop.password_message }}</p>
  {% endif %}

  {% form 'storefront_password', class: 'password__form' %}
    {% if form.errors %}
      <div role="alert">{{ form.errors | default_errors }}</div>
    {% endif %}

    <div class="field">
      <label class="field__label" for="Password-{{ section.id }}">{{ 'password.password' | t }}</label>
      <input class="field__input" type="password" name="password" id="Password-{{ section.id }}" autocomplete="current-password">
    </div>

    <button type="submit" class="button button--primary" data-magnetic>{{ 'password.enter' | t }}</button>
  {% endform %}
</div>

{% stylesheet %}
  .password {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-m);
    min-height: 100svh;
    padding-block: var(--space-2xl);
    text-align: center;
  }

  .password__badge {
    margin-block-end: var(--space-l);
  }

  .password__title {
    font-size: var(--text-display);
    line-height: var(--leading-display);
  }

  .password__form {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-m);
    width: min(24rem, 100%);
    margin-block-start: var(--space-l);
    text-align: start;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
