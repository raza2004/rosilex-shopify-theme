{% comment %}
  Main product section: sticky media gallery on the left, product details
  built from blocks on the right. Variant changes re-render the price, picker
  and buy buttons through the Section Rendering API so all text stays in
  Liquid and locale files.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign media_count = product.media.size
  assign selected_media = current_variant.featured_media | default: product.featured_media
%}

<product-info
  class="product"
  data-section-id="{{ section.id }}"
  data-url="{{ product.url }}"
  data-error-text="{{ 'products.add_error' | t | escape }}"
>
  <div class="product__gallery">
    <product-gallery class="product-gallery">
      <div
        class="product-gallery__viewport"
        data-motion="clip"
        tabindex="0"
        role="region"
        aria-label="{{ 'products.gallery_label' | t }}"
      >
        <ul class="product-gallery__slides" role="list">
          {% for media in product.media %}
            <li
              class="product-gallery__slide"
              data-media-id="{{ media.id }}"
              {% unless media.id == selected_media.id %}
                inert
              {% endunless %}
            >
              {% if media.media_type == 'image' %}
                {% liquid
                  if forloop.first
                    assign loading = 'eager'
                    assign fetchpriority = 'high'
                  else
                    assign loading = 'lazy'
                    assign fetchpriority = 'auto'
                  endif
                %}
                {{
                  media
                  | image_url: width: 2400
                  | image_tag:
                    class: 'product-gallery__image',
                    widths: '600, 900, 1200, 1600, 2000, 2400',
                    sizes: '(min-width: 990px) 55vw, 100vw',
                    loading: loading,
                    fetchpriority: fetchpriority
                }}
              {% else %}
                <div class="product-gallery__embed">
                  {{ media | media_tag: image_size: '1600x' }}
                </div>
              {% endif %}
            </li>
          {% else %}
            <li class="product-gallery__slide">
              {% render 'product-cover', title: product.title %}
            </li>
          {% endfor %}
        </ul>
      </div>

      {% if media_count > 1 %}
        <ul class="product-gallery__thumbs" role="list">
          {% for media in product.media %}
            <li>
              <button
                type="button"
                class="product-gallery__thumb"
                data-media-id="{{ media.id }}"
                aria-label="{{ 'products.show_media' | t: index: forloop.index, count: media_count }}"
                {% if media.id == selected_media.id %}
                  aria-current="true"
                {% endif %}
              >
                {{
                  media.preview_image
                  | image_url: width: 200
                  | image_tag: widths: '100, 200', sizes: '5rem', loading: 'lazy', alt: ''
                }}
              </button>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </product-gallery>
  </div>

  <div class="product__details" data-motion="rise">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'title' %}
          <h1 class="product__title" data-motion="lines" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

        {% when 'vendor' %}
          <p class="product__vendor eyebrow" {{ block.shopify_attributes }}>{{ product.vendor | escape }}</p>

        {% when 'price' %}
          <div class="product__price" id="Price-{{ section.id }}" data-product-part {{ block.shopify_attributes }}>
            {% render 'price', variant: current_variant %}
          </div>

        {% when 'description' %}
          {% if product.description != blank %}
            <div class="product__description text-muted" {{ block.shopify_attributes }}>
              {{ product.description }}
            </div>
          {% endif %}

        {% when 'variant_picker' %}
          {% unless product.has_only_default_variant %}
            <div class="variant-picker" id="Picker-{{ section.id }}" data-product-part {{ block.shopify_attributes }}>
              {% for option in product.options_with_values %}
                <fieldset class="variant-picker__option">
                  <legend class="variant-picker__legend eyebrow">{{ option.name | escape }}</legend>
                  <div class="variant-picker__values">
                    {% for value in option.values %}
                      <label class="variant-picker__value{% unless value.available %} variant-picker__value--unavailable{% endunless %}">
                        <input
                          class="visually-hidden"
                          type="radio"
                          name="{{ section.id }}-option-{{ option.position }}"
                          value="{{ value | escape }}"
                          data-option-value-id="{{ value.id }}"
                          {% if value.selected %}
                            checked
                          {% endif %}
                        >
                        <span>{{ value | escape }}</span>
                        {% unless value.available %}
                          <span class="visually-hidden">{{ 'products.unavailable' | t }}</span>
                        {% endunless %}
                      </label>
                    {% endfor %}
                  </div>
                </fieldset>
              {% endfor %}
            </div>
          {% endunless %}

        {% when 'buy_buttons' %}
          <div
            class="buy-buttons"
            id="BuyButtons-{{ section.id }}"
            data-product-part
            data-variant-id="{{ current_variant.id }}"
            data-media-id="{{ current_variant.featured_media.id }}"
            {{ block.shopify_attributes }}
          >
            {% form 'product', product, class: 'buy-buttons__form', novalidate: 'novalidate' %}
              <input type="hidden" name="id" value="{{ current_variant.id }}">

              <div class="buy-buttons__row">
                <div class="quantity">
                  <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
                  <button
                    type="button"
                    class="quantity__step"
                    data-quantity-step="-1"
                    aria-label="{{ 'products.decrease_quantity' | t }}"
                  >
                    <span aria-hidden="true">&minus;</span>
                  </button>
                  <input
                    class="quantity__input"
                    id="Quantity-{{ section.id }}"
                    type="number"
                    name="quantity"
                    value="1"
                    min="1"
                    inputmode="numeric"
                  >
                  <button
                    type="button"
                    class="quantity__step"
                    data-quantity-step="1"
                    aria-label="{{ 'products.increase_quantity' | t }}"
                  >
                    <span aria-hidden="true">+</span>
                  </button>
                </div>

                <button
                  type="submit"
                  name="add"
                  class="button button--primary buy-buttons__add"
                  {% unless current_variant.available %}
                    disabled
                  {% endunless %}
                >
                  {%- if current_variant.available -%}
                    {{ 'products.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.sold_out' | t }}
                  {%- endif -%}
                </button>
              </div>

              <p class="buy-buttons__error" role="alert"></p>

              {% if block.settings.show_dynamic_checkout %}
                {{ form | payment_button }}
              {% endif %}
            {% endform %}
          </div>

        {% when 'accordion' %}
          {% liquid
            # A blank heading falls back to the translated name of a known metafield
            assign accordion_heading = block.settings.heading
            if accordion_heading == blank
              case block.settings.metafield_key
                when 'ingredients'
                  assign accordion_heading = 'products.accordion_ingredients' | t
                when 'how_to_use'
                  assign accordion_heading = 'products.accordion_how_to_use' | t
                when 'skin_type'
                  assign accordion_heading = 'products.accordion_skin_type' | t
              endcase
            endif

            assign accordion_content = block.settings.content
            if accordion_content == blank
              if block.settings.metafield_key != blank
                assign accordion_metafield = product.metafields.custom[block.settings.metafield_key]
                if accordion_metafield != blank
                  assign accordion_content = accordion_metafield | metafield_tag
                endif
              endif
            endif
          %}

          {% if accordion_content != blank or request.design_mode %}
            <details
              class="accordion"
              {% if block.settings.open_by_default %}
                open
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <summary class="accordion__summary">
                <span>{{ accordion_heading | escape }}</span>
                <span class="accordion__icon" aria-hidden="true"></span>
              </summary>
              <div class="accordion__content text-muted">
                {%- if accordion_content != blank -%}
                  {{ accordion_content }}
                {%- else -%}
                  <p>{{ 'products.accordion_empty' | t: key: block.settings.metafield_key }}</p>
                {%- endif -%}
              </div>
            </details>
          {% endif %}
      {% endcase %}
    {% endfor %}
  </div>
</product-info>

{% stylesheet %}
  .product {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
    padding-block: var(--space-m) var(--space-section);
  }

  /* Gallery: one frame at a time, swipe or scroll between images. */
  .product-gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .product-gallery__viewport {
    aspect-ratio: 4 / 5;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    background-color: var(--color-surface);
  }

  .product-gallery__viewport::-webkit-scrollbar {
    display: none;
  }

  .product-gallery__viewport:focus-visible {
    outline: 1px solid var(--color-foreground);
    outline-offset: 3px;
  }

  .product-gallery__slides {
    display: flex;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-gallery__slide {
    flex: 0 0 100%;
    height: 100%;
    scroll-snap-align: start;
  }

  .product-gallery__image,
  .product-gallery__embed,
  .product-gallery__embed > * {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-gallery__image--placeholder {
    fill: var(--color-border);
  }

  .product-gallery__thumbs {
    display: flex;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
  }

  .product-gallery__thumb {
    display: block;
    width: 4rem;
    aspect-ratio: 4 / 5;
    padding: 0;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid transparent;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .product-gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-gallery__thumb:hover,
  .product-gallery__thumb[aria-current='true'] {
    opacity: 1;
  }

  .product-gallery__thumb[aria-current='true'] {
    border-color: var(--color-foreground);
  }

  .product-gallery__thumb:focus-visible {
    outline: 1px solid var(--color-foreground);
    outline-offset: 2px;
  }

  /* Details */
  .product__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .product__title {
    font-size: var(--text-3xl);
    line-height: var(--leading-display);
  }

  .product__vendor {
    margin-block-end: calc(var(--space-s) * -1);
  }

  .product__price {
    font-size: var(--text-l);
  }

  .product__description {
    max-width: var(--measure);
  }

  .variant-picker {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .variant-picker__option {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .variant-picker__legend {
    margin-block-end: var(--space-xs);
  }

  .variant-picker__values {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .variant-picker__value {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-m);
    font-size: var(--text-s);
    border: 1px solid var(--color-border);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .variant-picker__value:hover {
    border-color: var(--color-foreground);
  }

  .variant-picker__value:has(:checked) {
    color: var(--color-background);
    background-color: var(--color-foreground);
    border-color: var(--color-foreground);
  }

  .variant-picker__value:has(:focus-visible) {
    outline: 1px solid var(--color-foreground);
    outline-offset: 3px;
  }

  .variant-picker__value--unavailable span:first-of-type {
    text-decoration: line-through;
    color: var(--color-muted);
  }

  .buy-buttons__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .buy-buttons__row {
    display: flex;
    gap: var(--space-xs);
  }

  .buy-buttons__add {
    flex: 1;
  }

  .buy-buttons__add[aria-busy='true'] {
    opacity: 0.7;
    cursor: progress;
  }

  /* Shopify's "Buy it now" button, restyled to match the theme's outline button. */
  .buy-buttons .shopify-payment-button__button--unbranded {
    min-height: 3.5rem;
    font-family: inherit;
    font-size: var(--text-xs);
    font-weight: inherit;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-foreground);
    background-color: transparent;
    border: 1px solid var(--color-foreground);
    border-radius: 0;
    transition:
      background-color 0.6s var(--ease-out),
      color 0.6s var(--ease-out),
      border-color 0.6s var(--ease-out);
  }

  .buy-buttons .shopify-payment-button__button--unbranded:hover:not([disabled]) {
    color: var(--color-deep);
    background-color: var(--color-metal);
    border-color: var(--color-metal);
  }

  .buy-buttons__error:empty {
    display: none;
  }

  .buy-buttons__error {
    font-size: var(--text-s);
    color: var(--color-foreground);
  }

  /* Accordion: consecutive blocks share one border between them. */
  .accordion {
    border-block-start: 1px solid var(--color-border);
  }

  .accordion:not(:has(+ .accordion)) {
    border-block-end: 1px solid var(--color-border);
  }

  .accordion + .accordion {
    margin-block-start: calc(var(--space-m) * -1);
  }

  .accordion__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-s);
    padding-block: var(--space-m);
    list-style: none;
    cursor: pointer;
  }

  .accordion__summary::-webkit-details-marker {
    display: none;
  }

  .accordion__summary:focus-visible {
    outline: 1px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .accordion__icon {
    position: relative;
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
  }

  .accordion__icon::before,
  .accordion__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background-color: currentcolor;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .accordion__icon::after {
    transform: rotate(90deg);
  }

  .accordion[open] .accordion__icon::after {
    transform: rotate(0deg);
  }

  .accordion__content {
    padding-block-end: var(--space-m);
    max-width: var(--measure);
  }

  @media screen and (min-width: 990px) {
    .product {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-2xl);
      align-items: start;
    }

    .product__gallery {
      position: sticky;
      top: var(--space-m);
    }

    .product-gallery {
      flex-direction: row-reverse;
      align-items: flex-start;
    }

    .product-gallery__viewport {
      flex: 1;
      max-height: calc(100svh - var(--space-m) * 2);
    }

    .product-gallery__thumbs {
      flex-direction: column;
      max-height: calc(100svh - var(--space-m) * 2);
      overflow-y: auto;
    }

    .product-gallery__thumb {
      width: 4.5rem;
    }

    .product__details {
      padding-block-start: var(--space-2xl);
    }
  }
{% endstylesheet %}

{% javascript %}
  class ProductGallery extends HTMLElement {
    connectedCallback() {
      this.viewport = this.querySelector('.product-gallery__viewport');
      this.slides = [...this.querySelectorAll('.product-gallery__slide')];
      this.thumbs = [...this.querySelectorAll('.product-gallery__thumb')];

      this.addEventListener('click', (event) => {
        const thumb = event.target.closest('.product-gallery__thumb');
        if (thumb) this.select(thumb.dataset.mediaId);
      });

      const onScrollEnd = () => this.sync();
      if ('onscrollend' in window) {
        this.viewport.addEventListener('scrollend', onScrollEnd);
      } else {
        let timer;
        this.viewport.addEventListener('scroll', () => {
          clearTimeout(timer);
          timer = setTimeout(onScrollEnd, 120);
        });
      }

      // Start on the selected variant's media.
      const selected = this.slides.find((slide) => !slide.inert);
      if (selected) this.viewport.scrollLeft = selected.offsetLeft;
    }

    select(mediaId) {
      const slide = this.slides.find((slide) => slide.dataset.mediaId === String(mediaId));
      if (!slide) return;

      const reduce = !document.documentElement.classList.contains('motion-ok');
      this.viewport.scrollTo({ left: slide.offsetLeft, behavior: reduce ? 'auto' : 'smooth' });
      this.mark(slide);
    }

    sync() {
      const index = Math.round(this.viewport.scrollLeft / this.viewport.clientWidth);
      if (this.slides[index]) this.mark(this.slides[index]);
    }

    mark(activeSlide) {
      this.slides.forEach((slide) => (slide.inert = slide !== activeSlide));
      this.thumbs.forEach((thumb) => {
        if (thumb.dataset.mediaId === activeSlide.dataset.mediaId) {
          thumb.setAttribute('aria-current', 'true');
        } else {
          thumb.removeAttribute('aria-current');
        }
      });
    }
  }

  class ProductInfo extends HTMLElement {
    connectedCallback() {
      this.addEventListener('change', (event) => {
        if (event.target.matches('[data-option-value-id]')) this.onOptionChange(event.target);
      });

      this.addEventListener('click', (event) => {
        const step = event.target.closest('[data-quantity-step]');
        if (step) this.stepQuantity(step);
      });

      this.addEventListener('submit', (event) => {
        if (event.target.matches('.buy-buttons__form')) this.onSubmit(event);
      });
    }

    stepQuantity(button) {
      const input = button.parentElement.querySelector('.quantity__input');
      const next = Math.max(1, (parseInt(input.value, 10) || 1) + Number(button.dataset.quantityStep));
      input.value = next;
    }

    async onOptionChange(input) {
      const optionValueIds = [...this.querySelectorAll('[data-option-value-id]:checked')].map(
        (checked) => checked.dataset.optionValueId
      );
      const url = `${this.dataset.url}?section_id=${this.dataset.sectionId}&option_values=${optionValueIds.join(',')}`;

      this.abortController?.abort();
      this.abortController = new AbortController();

      try {
        const response = await fetch(url, { signal: this.abortController.signal });
        const html = new DOMParser().parseFromString(await response.text(), 'text/html');
        this.renderParts(html, input.dataset.optionValueId);
      } catch (error) {
        if (error.name !== 'AbortError') console.error(error);
      }
    }

    renderParts(html, focusOptionValueId) {
      this.querySelectorAll('[data-product-part]').forEach((part) => {
        const next = html.getElementById(part.id);
        if (next) part.replaceWith(next);
      });

      // Keep keyboard focus on the option the shopper just picked.
      this.querySelector(`[data-option-value-id="${focusOptionValueId}"]`)?.focus();

      const buyButtons = this.querySelector('.buy-buttons');
      if (!buyButtons) return;

      const { variantId, mediaId } = buyButtons.dataset;
      if (variantId) {
        const url = new URL(window.location.href);
        url.searchParams.set('variant', variantId);
        window.history.replaceState({}, '', url);
      }

      if (mediaId) this.querySelector('product-gallery')?.select(mediaId);

      window.Shopify?.PaymentButton?.init();
    }

    async onSubmit(event) {
      // Without the cart drawer, fall back to the normal form post to /cart.
      if (!document.querySelector('cart-drawer')) return;

      event.preventDefault();

      const form = event.target;
      const button = form.querySelector('[type="submit"]');
      const error = form.querySelector('.buy-buttons__error');
      if (button.getAttribute('aria-busy') === 'true') return;

      button.setAttribute('aria-busy', 'true');
      error.textContent = '';

      const body = new FormData(form);
      body.append('sections', 'cart-drawer');
      body.append('sections_url', window.location.pathname);

      try {
        const response = await fetch(`${window.Shopify.routes.root}cart/add.js`, {
          method: 'POST',
          headers: { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body,
        });
        const data = await response.json();

        if (!response.ok) {
          error.textContent = data.description || data.message;
          return;
        }

        document.dispatchEvent(
          new CustomEvent('cart:added', { detail: { sections: data.sections, opener: button } })
        );
      } catch {
        error.textContent = this.dataset.errorText;
      } finally {
        button.removeAttribute('aria-busy');
      }
    }
  }

  if (!customElements.get('product-gallery')) customElements.define('product-gallery', ProductGallery);
  if (!customElements.get('product-info')) customElements.define('product-info', ProductInfo);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product",
  "tag": "section",
  "class": "product-section",
  "blocks": [
    {
      "type": "vendor",
      "name": "t:general.vendor",
      "limit": 1
    },
    {
      "type": "title",
      "name": "t:labels.title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "t:general.price",
      "limit": 1
    },
    {
      "type": "description",
      "name": "t:general.description",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "t:general.variant_picker",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "t:general.buy_buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "t:labels.show_dynamic_checkout",
          "default": true
        }
      ]
    },
    {
      "type": "accordion",
      "name": "t:general.accordion",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.headline",
          "info": "t:info.accordion_heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:labels.content"
        },
        {
          "type": "text",
          "id": "metafield_key",
          "label": "t:labels.metafield_key",
          "info": "t:info.metafield_key"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "t:labels.open_by_default",
          "default": false
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
