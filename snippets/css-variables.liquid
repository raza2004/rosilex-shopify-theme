{% doc %}
  Outputs the theme's font faces and design tokens as CSS custom properties.

  Colors and fonts come from theme settings so they update live in the
  theme editor. The type scale, spacing scale and motion tokens are static.

  @example
  {% render 'css-variables' %}
{% enddoc %}

{% style %}
  {% # Loads font variations with display: swap %}
  {{ settings.type_display_font | font_face: font_display: 'swap' }}
  {{ settings.type_display_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    /* Layout */
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;

    /*
     * Colors. A deep anchor, one metallic used sparingly, and quiet neutrals.
     * --color-background and --color-foreground belong to the current scheme
     * (light here, deep inside .scheme-deep); --color-deep and --color-metal
     * are fixed brand colors available everywhere.
     */
    --color-light: {{ settings.background_color }};
    --color-ink: {{ settings.foreground_color }};
    --color-deep: {{ settings.deep_color }};
    --color-deep-foreground: {{ settings.deep_foreground_color }};
    --color-metal: {{ settings.accent_color }};
    --color-aurora: {{ settings.aurora_color }};

    --color-background: var(--color-light);
    --color-foreground: var(--color-ink);
    --color-accent: var(--color-metal);

    /* Fonts */
    --font-display--family: {{ settings.type_display_font.family }}, {{ settings.type_display_font.fallback_families }};
    --font-display--style: {{ settings.type_display_font.style }};
    --font-display--weight: {{ settings.type_display_font.weight }};
    --font-body--family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    --font-body--style: {{ settings.type_body_font.style }};
    --font-body--weight: {{ settings.type_body_font.weight }};

    /*
     * Fluid type scale, mobile first. Each step interpolates linearly from a
     * 320px viewport (min) to a 1440px viewport (max).
     */
    --fluid: ((100vw - 20rem) / 70);
    --text-xs: clamp(0.75rem, 0.75rem + 0.0625 * var(--fluid), 0.8125rem);
    --text-s: clamp(0.875rem, 0.875rem + 0.0625 * var(--fluid), 0.9375rem);
    --text-m: clamp(1rem, 1rem + 0.0625 * var(--fluid), 1.0625rem);
    --text-l: clamp(1.25rem, 1.25rem + 0.25 * var(--fluid), 1.5rem);
    --text-xl: clamp(1.5625rem, 1.5625rem + 0.4375 * var(--fluid), 2rem);
    --text-2xl: clamp(1.9375rem, 1.9375rem + 0.8125 * var(--fluid), 2.75rem);
    --text-3xl: clamp(2.4375rem, 2.4375rem + 1.3125 * var(--fluid), 3.75rem);
    --text-display: clamp(3rem, 3rem + 2.5 * var(--fluid), 5.5rem);

    --leading-display: 1.04;
    --leading-heading: 1.15;
    --leading-body: 1.6;
    --tracking-display: -0.02em;
    --tracking-eyebrow: 0.14em;
    --measure: 62ch;

    /* Spacing scale */
    --space-3xs: 0.25rem;
    --space-2xs: 0.5rem;
    --space-xs: 0.75rem;
    --space-s: 1rem;
    --space-m: 1.5rem;
    --space-l: 2rem;
    --space-xl: 3rem;
    --space-2xl: 4.5rem;
    --space-3xl: 7rem;
    --space-section: clamp(4.5rem, 4.5rem + 5.5 * var(--fluid), 10rem);

    /* Motion. Mirrors the defaults in motion.js for CSS-only transitions. */
    --ease-out: cubic-bezier(0.215, 0.61, 0.355, 1);
    --duration-fast: 0.3s;
    --duration-slow: 1.1s;

    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
  }
{% endstyle %}
