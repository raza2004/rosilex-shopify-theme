{% doc %}
  Renders the editorial header used at the top of each page: an optional
  eyebrow, a large display title that reveals line by line, optional intro
  text, and an optional rotating badge.

  @param {string} title - The page title, plain text
  @param {string} [eyebrow] - Small label above the title
  @param {string} [text] - Intro HTML shown beside the title
  @param {boolean} [badge] - Show the rotating badge
  @param {string} [id] - Unique id for the badge, usually section.id

  @example
  {% render 'page-header', title: page.title, eyebrow: shop.name, badge: true, id: section.id %}
{% enddoc %}

<header class="page-header{% if badge %} page-header--badge{% endif %}">
  <div class="page-header__copy">
    {% if eyebrow != blank %}
      <p class="eyebrow text-muted" data-motion="up">{{ eyebrow | escape }}</p>
    {% endif %}

    <h1 class="page-header__title" data-motion="lines">{{ title | escape }}</h1>
  </div>

  {% if text != blank %}
    <div class="page-header__text text-muted measure" data-motion="up">{{ text }}</div>
  {% endif %}

  {% if badge %}
    {% render 'badge', id: id, css_class: 'page-header__badge' %}
  {% endif %}
</header>

{% stylesheet %}
  .page-header {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .page-header__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .page-header__title {
    font-size: var(--text-display);
    line-height: var(--leading-display);
    max-width: 16ch;
  }

  .page-header__badge {
    align-self: flex-end;
    margin-block-start: calc(var(--space-xl) * -1);
  }

  @media screen and (min-width: 750px) {
    .page-header {
      display: grid;
      grid-template-columns: 7fr 4fr;
      align-items: end;
      gap: var(--space-2xl);
      padding-block: var(--space-2xl) var(--space-3xl);
    }

    .page-header__badge {
      position: absolute;
      inset-block-start: var(--space-xl);
      inset-inline-end: 0;
      margin: 0;
    }

    .page-header--badge .page-header__text {
      margin-block-start: var(--space-3xl);
    }
  }
{% endstylesheet %}
