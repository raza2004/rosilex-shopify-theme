{% doc %}
  Renders an editorial product card: image, title and price, linked to the
  product. Renders placeholder content when no product is given, so sections
  still preview in the theme editor before a collection is picked.

  @param {product} [product] - The product to render
  @param {string} [sizes] - The sizes attribute for the product image
  @param {string} [css_class] - Optional class added to the card wrapper

  @example
  {% render 'product-card', product: product, sizes: '(min-width: 750px) 30vw, 50vw' %}
{% enddoc %}

{% liquid
  assign sizes = sizes | default: '(min-width: 750px) 33vw, 100vw'
  assign image = product.featured_media.preview_image
  assign hover_image = product.media[1].preview_image

  if product
    assign wrapper = 'a'
  else
    assign wrapper = 'div'
  endif
%}

<article class="product-card {{ css_class }}">
  <{{ wrapper }}
    class="product-card__link"
    {% if product %}
      href="{{ product.url }}"
      data-cursor="{{ 'general.cursor_view' | t | escape }}"
    {% endif %}
  >
    <div class="product-card__media{% if hover_image %} product-card__media--hover{% endif %}">
      {% if image %}
        {{
          image
          | image_url: width: 1800
          | image_tag:
            class: 'product-card__image',
            widths: '400, 600, 900, 1200, 1800',
            sizes: sizes,
            loading: 'lazy'
        }}

        {% if hover_image %}
          {{
            hover_image
            | image_url: width: 1800
            | image_tag:
              class: 'product-card__image product-card__image--hover',
              widths: '400, 600, 900, 1200, 1800',
              sizes: sizes,
              loading: 'lazy',
              alt: ''
          }}
        {% endif %}
      {% else %}
        {% render 'product-cover', title: product.title %}
      {% endif %}
    </div>

    <div class="product-card__info">
      <h3 class="product-card__title">
        {%- if product -%}
          {{ product.title | escape }}
        {%- else -%}
          {{ 'products.placeholder_title' | t }}
        {%- endif -%}
      </h3>

      <p class="product-card__price">
        {%- if product and product.available == false -%}
          {{ 'products.sold_out' | t }}
        {%- else -%}
          {% render 'price', product: product %}
        {%- endif -%}
      </p>
    </div>
  </{{ wrapper }}>
</article>

{% stylesheet %}
  .product-card__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    color: inherit;
    text-decoration: none;
  }

  .product-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: var(--color-surface);
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Packshots shot on white melt into the image well instead of showing a white box. */
    mix-blend-mode: multiply;
    transition:
      transform 1.4s var(--ease-out),
      opacity 0.8s var(--ease-out);
  }

  /* Multiply would darken photos on a dark ground. */
  :root[data-theme='night'] .product-card__image,
  .scheme-deep .product-card__image {
    mix-blend-mode: normal;
  }

  .product-card__image--placeholder {
    fill: var(--color-border);
  }

  /* Hover: slow zoom, and a cross-fade to the second photo when there is one. */
  .product-card__image--hover {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.08);
  }

  .product-card__link:hover .product-card__image {
    transform: scale(1.06);
  }

  .product-card__link:hover .product-card__image--hover {
    opacity: 1;
    transform: scale(1);
  }

  .product-card__title {
    position: relative;
    display: inline-block;
  }

  .product-card__title::after {
    content: '';
    position: absolute;
    inset: auto 0 -0.15em;
    height: 1px;
    background-color: currentcolor;
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform 0.7s var(--ease-out);
  }

  .product-card__link:hover .product-card__title::after {
    transform: scaleX(1);
    transform-origin: 0% 50%;
  }

  .product-card__info {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3xs) var(--space-s);
  }

  .product-card__title {
    font-size: var(--text-l);
  }

  .product-card__price {
    flex-shrink: 0;
    font-size: var(--text-s);
  }
{% endstylesheet %}
